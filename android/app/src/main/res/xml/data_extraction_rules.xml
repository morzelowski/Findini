<?xml version="1.0" encoding="utf-8"?>
<!-- Token sesji i szkice nie trafiają do kopii zapasowych ani transferu między urządzeniami.
     Klucz szyfrujący z Android Keystore i tak nie dałby się przenieść. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
