# Skopiuj do .env i uzupełnij. NIE commituj pliku .env.
# --- baza danych
POSTGRES_USER=findini
POSTGRES_PASSWORD=zmien-to-haslo
POSTGRES_DB=findini

# --- API
FINDINI_ENV=dev                      # dev | prod
# Sekret serwera (min. 32 znaki), np.: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
FINDINI_SERVER_SECRET=
# Token panelu moderacji /admin (min. 24 znaki). Pusty = moderacja wyłączona.
FINDINI_ADMIN_TOKEN=
FINDINI_PUBLIC_BASE_URL=http://localhost:8080
FINDINI_AI_ENABLED=true
FINDINI_SEED_DEMO=0                  # 1 = załaduj oznaczone dane demonstracyjne przy pustej bazie
FINDINI_WORKERS=1
API_BIND=0.0.0.0                     # 127.0.0.1 za reverse proxy; 0.0.0.0 by telefon w sieci LAN miał dostęp
API_PORT=8080

# --- HTTPS (profil "https")
FINDINI_DOMAIN=findini.example.org
# FINDINI_TRUST_PROXY_HEADERS=true
# FINDINI_FORWARDED_ALLOW_IPS=*
